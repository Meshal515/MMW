{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uspace",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {"required": ["DEEPSEEK_API_KEY", "APP_ACCESS_KEY"]},
  "observability": {"enabled": false}
}
