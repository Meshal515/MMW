/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Pages serves static assets with max-age=0, must-revalidate by default, so every
# cover, font and vendor script cost a revalidation round trip on every load.
# These files are stable, and the service worker (sw.js, exempted above) is the
# layer that decides when to refresh them, so let the browser keep them.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# A week rather than a year: covers can be replaced under the same name, and a
# bumped worker VERSION should not leave a stale one stranded in the browser.
#
# No generic /assets/* catch-all here: Cloudflare Pages does not let the most
# specific _headers rule win — every pattern that matches a path has its
# Cache-Control appended to the others, so a broader rule below this one would
# not override it, it would concatenate with it (confirmed live: covers and
# fonts both shipped two comma-joined Cache-Control values before this fix).
# logo.svg and the two icon PNGs are what would have fallen under a catch-all;
# they're a few KB each and unchanged since launch, so Pages' own default
# (max-age=0, revalidate) for them is a fair trade against not re-introducing
# the bug this comment describes.
/assets/covers/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
